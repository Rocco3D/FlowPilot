{
  "name": "flowpilot-cli",
  "version": "0.1.0",
  "description": "Local service that drives Google Flow through your own Chrome, with a CLI, a local HTTP API and an MCP server.",
  "keywords": [
    "google-flow",
    "flow",
    "veo",
    "nano-banana",
    "ai-video",
    "ai-image",
    "cli",
    "mcp",
    "automation"
  ],
  "type": "module",
  "bin": {
    "flowpilot": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT",
  "author": "Rocco Bruno",
  "homepage": "https://github.com/Rocco3D/FlowPilot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rocco3D/FlowPilot.git"
  },
  "bugs": {
    "url": "https://github.com/Rocco3D/FlowPilot/issues"
  },
  "files": [
    "dist",
    "README.md",
    "README.it.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "commander": "^15.0.0",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
