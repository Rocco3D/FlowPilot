{
  "name": "flowpilot-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Local service that drives Google Flow through your own Chrome, with a CLI, a local HTTP API and an MCP server.",
  "type": "module",
  "bin": {
    "flowpilot": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT",
  "author": "Rocco Bruno",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
